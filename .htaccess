Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + 非www を正規URLへ統一
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.playpoint-sim\.com$ [NC]
  RewriteRule ^ https://playpoint-sim.com%{REQUEST_URI} [R=301,L]

  # 旧URLをトップへ統一
  RewriteCond %{THE_REQUEST} \s/+calculator\.html[\s?] [NC]
  RewriteRule ^calculator\.html$ / [R=301,L,NE]

  # PlayPointと無関係な実験ツールはKatakataLabへ恒久移設
  RewriteRule ^tools/dashboard(?:/(.*))?$ https://katakatalab.com/lab-tools/side-fire-dashboard/$1 [R=301,L,NE]
  RewriteRule ^tools/gravity-todo(?:/(.*))?$ https://katakatalab.com/lab-tools/gravity-todo/$1 [R=301,L,NE]
  RewriteRule ^tools/rakuten-sim(?:/(.*))?$ https://katakatalab.com/lab-tools/rakuten-sim/$1 [R=301,L,NE]
  RewriteRule ^tools/sub-health(?:/(.*))?$ https://katakatalab.com/lab-tools/sub-health/$1 [R=301,L,NE]
  RewriteRule ^kindle-tracker(?:/(.*))?$ https://katakatalab.com/lab-tools/kindle-tracker/$1 [R=301,L,NE]
  RewriteRule ^kids-smile-land(?:/(.*))?$ https://katakatalab.com/lab-tools/kids-smile-land/$1 [R=301,L,NE]
  RewriteRule ^doujin-shi-calculator(?:/(.*))?$ https://katakatalab.com/lab-tools/doujin-shi-calculator/$1 [R=301,L,NE]
  RewriteRule ^articles/2026-06-29-savings-game-fire\.html$ https://katakatalab.com/lab-tools/savings-game-fire/ [R=301,L,NE]

  # 検索意図が重複した反映トラブル記事は包括記事へ統合
  RewriteRule ^articles/2025-12-25-playpoints-not-reflected\.html$ /articles/2026-03-10-play-points-reflection-timing.html [R=301,L,NE]
  RewriteRule ^en/articles/google-play-points-reflection-timing\.html$ /en/articles/google-play-points-not-showing.html [R=301,L,NE]

  # 旧GitHub Pages URLが検索に残る場合はSearch Console側で正規URLを優先する
  # このサーバーでは playpoint-sim.com 配下の正規化だけを担当する

  # すべての /index.html を階層を保ったディレクトリURLへ統一
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
</IfModule>

<IfModule mod_deflate.c>
  # 転送量を減らして表示速度を改善
  AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript application/javascript application/json application/manifest+json application/xml application/rss+xml application/atom+xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # HTMLは短め、静的アセットは長めにキャッシュ
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType application/rss+xml "access plus 30 minutes"
  ExpiresByType application/atom+xml "access plus 30 minutes"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<Files "feed.xml">
  ForceType application/rss+xml
</Files>

<Files "atom.xml">
  ForceType application/atom+xml
</Files>

<Files "manifest.json">
  ForceType application/manifest+json
</Files>

<Files "deploy-status.json">
  ForceType application/json
</Files>

<Files "deploy-revision.txt">
  ForceType text/plain
</Files>

<IfModule mod_headers.c>
  Header append Vary Accept-Encoding
  # 内容ハッシュ付きのCSS/JSだけを長期保存する。未バージョン資産は上記Expiresの短期設定を維持する。
  Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ m#(^|&)v=[a-zA-Z0-9_-]+(&|$)#"
  <Files "feed.xml">
    Header set Cache-Control "public, max-age=1800"
  </Files>
  <Files "atom.xml">
    Header set Cache-Control "public, max-age=1800"
  </Files>
  <Files "manifest.json">
    Header set Cache-Control "public, max-age=86400"
  </Files>
  <FilesMatch "^deploy-(status\.json|revision\.txt)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googlesyndication.com https://*.googletagmanager.com https://*.google-analytics.com https://*.googleadservices.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.googlesyndication.com https://pagead2.googlesyndication.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.g.doubleclick.net https://*.google.com https://*.adtrafficquality.google; frame-src https://*.googlesyndication.com https://*.google.com https://*.doubleclick.net; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>
