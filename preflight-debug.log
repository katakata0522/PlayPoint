+  <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Play Games 경험치를 Play Points로 바꿀 수 있나요?","acceptedAnswer":{"@type":"Answer","text":"아니요. Play Games 경험치와 업적은 게임 프로필 정보이며 Play Points로 전환되지 않습니다."}},{"@type":"Question","name":"게임을 플레이하면 Play Points가 적립되나요?","acceptedAnswer":{"@type":"Answer","text":"계정에 표시된 퀘스트나 설치 프로모션이 해당 활동을 요구하고 조건을 완료한 경우에만 적립될 수 있습니다."}},{"@type":"Question","name":"PC용 Google Play Games 구매도 포인트가 적립되나요?","acceptedAnswer":{"@type":"Answer","text":"대상 Google Play 구매는 PC에서도 적립될 수 있지만 퀘스트와 일부 프로모션은 모바일에서 확인해야 합니다."}}]}</script>
