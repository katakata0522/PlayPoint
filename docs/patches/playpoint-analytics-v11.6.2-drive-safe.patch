 function createOrReplaceTextFile_(folder, fileName, text, mimeType) {
+  const content = String(text || '');
+  const type = mimeType || 'text/plain';
   const existing = folder.getFilesByName(fileName);
-  while (existing.hasNext()) existing.next().setTrashed(true);
-  const blob = Utilities.newBlob(String(text || ''), mimeType || 'text/plain', fileName);
-  folder.createFile(blob);
+  let lastUpdateError = null;
+
+  // 同名ファイルがあれば、所有者だけが可能なsetTrashed()ではなく内容更新を優先する。
+  // 編集者権限で更新できる既存ファイルを1件でも見つけた時点で完了する。
+  while (existing.hasNext()) {
+    const file = existing.next();
+    try {
+      file.setContent(content);
+      return file;
+    } catch (error) {
+      lastUpdateError = error;
+    }
+  }
+
+  if (!lastUpdateError) {
+    const blob = Utilities.newBlob(content, type, fileName);
+    return folder.createFile(blob);
+  }
+
+  // 既存ファイルを編集できない場合も、既存物を削除せず別名で退避保存する。
+  // これにより、別アカウント所有ファイルが混在してもアーカイブ処理を継続できる。
+  const fallbackName = uniqueArchiveFallbackName_(fileName);
+  console.warn(
+    '既存Driveファイルを更新できないため別名保存へフォールバック: ' +
+    fileName + ' -> ' + fallbackName + ' / ' + errorMessage_(lastUpdateError)
+  );
+  const fallbackBlob = Utilities.newBlob(content, type, fallbackName);
+  return folder.createFile(fallbackBlob);
+}
+
+function uniqueArchiveFallbackName_(fileName) {
+  const timestamp = Utilities.formatDate(new Date(), CONFIG.TIME_ZONE, 'yyyyMMdd_HHmmss');
+  const name = String(fileName || 'archive.txt');
+  const dot = name.lastIndexOf('.');
+  if (dot <= 0) return name + '__writer_' + timestamp;
+  return name.substring(0, dot) + '__writer_' + timestamp + name.substring(dot);
 }

