+function validateApiDailyDate_(date, start, end, seen, label) {
+  const epoch = /^\d{4}-\d{2}-\d{2}$/.test(date) ? Date.parse(date + 'T00:00:00Z') : NaN;
+  if (!Number.isFinite(epoch) || new Date(epoch).toISOString().slice(0, 10) !== date || date < start || date > end) {
+    throw new Error(label + 'の日付が不正・要求期間外です。');
+  }
+  if (Object.prototype.hasOwnProperty.call(seen, date)) throw new Error(label + 'の日付が重複しています。');
