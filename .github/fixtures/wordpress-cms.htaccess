# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /cms/
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /cms/index.php [L]
</IfModule>
# END WordPress



# BEGIN PlayPoint staging WordPress editor
# Only the authenticated post editor needs WordPress's same-origin/blob canvas.
SetEnvIf Request_URI "^/cms/wp-admin/(post|post-new)\.php$" PPCS_EDITOR=1
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; worker-src 'self'; manifest-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests" env=PPCS_EDITOR
</IfModule>
# END PlayPoint staging WordPress editor


# BEGIN PlayPoint staging revision UI
# WordPress's shipped Underscore templates require new Function in this screen.
SetEnvIf Request_URI "^/cms/wp-admin/revision\.php$" PPCS_REVISION=1
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests" env=PPCS_REVISION
</IfModule>
# END PlayPoint staging revision UI

# BEGIN PlayPoint production CMS protection
Options -Indexes
<IfModule mod_headers.c>
  # 内部rewrite後も元のリクエスト行で判定し、管理・ログイン・エラーの保存拒否を維持する。
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" "expr=%{REQUEST_STATUS} != 200 || %{THE_REQUEST} !~ m#^(GET|HEAD) /articles/2026-10-13-play-fest-deals[.]html([?][^ ]*)? HTTP/[0-9.]+$#"
  Header always set Cache-Control "private, no-store, max-age=0"
  Header always set Vary "*" "expr=%{REQUEST_STATUS} != 200 || %{THE_REQUEST} !~ m#^(GET|HEAD) /articles/2026-10-13-play-fest-deals[.]html([?][^ ]*)? HTTP/[0-9.]+$#"
</IfModule>
<FilesMatch "^(wp-config[.]php|[.]playpoint-fest-enabled|.*[.](sql|bak|zip))$">
  Require all denied
</FilesMatch>
# END PlayPoint production CMS protection
